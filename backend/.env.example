# GreenLight API (Flask)
# Copia este archivo a .env y ajusta los valores.

# Base de datos. Por defecto usa SQLite local (greenlight.db).
# Para Supabase/PostgreSQL:
#   DATABASE_URL=postgresql://usuario:contraseña@host:5432/postgres
DATABASE_URL=

# Secreto para firmar los JWT. Cámbialo en producción.
SECRET_KEY=cambia-este-secreto-en-produccion

# Minutos de validez del token y umbral de confirmaciones comunitarias.
JWT_EXPIRATION_MINUTES=120
CONFIRMATION_THRESHOLD=3

# Supabase (para consultar en nombre del usuario vía RLS).
# Project URL y clave publishable/anon. NUNCA la service_role.
# El SQL está en backend/sql/01_esquema_y_rls.sql.
SUPABASE_URL=
SUPABASE_KEY=

# CORS: '*' en desarrollo o lista de orígenes separados por coma.
CORS_ORIGINS=*

# Rate limiting (OWASP API4): límites global y de login/registro por IP.
RATE_LIMIT_DEFAULT=2000 per hour
RATE_LIMIT_AUTH=30 per minute

# Puerto del servidor local.
PORT=5000
# GreenLight — variables de entorno (Flask)
# Copia este archivo a backend/.env y ajusta los valores.

# PostgreSQL (Supabase). Vacío = SQLite local.
DATABASE_URL=

# Secreto para firmar los JWT.
SECRET_KEY=cambia-este-secreto-en-produccion

JWT_EXPIRATION_MINUTES=120
CONFIRMATION_THRESHOLD=3
PORT=5000